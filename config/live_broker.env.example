# ==============================================================================
# DeltaUno Live Paper Trading Broker Credentials (Optional)
# Copy this file to `config/live_broker.env` (git-ignored) and fill in ANY ONE
# of your broker credentials below for True Exchange 5-Level L2 Order Book Depth.
#
# If left blank or not present, `scripts/run_live_paper_trading.py` automatically
# falls back to the Zero-Config Live NSE Streamer (₹0 / No API keys required).
# ==============================================================================

# Optional: Force a specific provider ("auto", "zerodha", "upstox", "angelone", "yahoo")
DELTAUNO_FEED_PROVIDER=auto

# --- OPTION 1: Zerodha Kite Connect (5-Level L2 Mode Full) ---
ZERODHA_API_KEY=
ZERODHA_ACCESS_TOKEN=

# --- OPTION 2: Upstox API v2 (Free with Demat — 5-Level L2 Full Market Quote) ---
UPSTOX_ACCESS_TOKEN=

# --- OPTION 3: AngelOne SmartAPI (Free with Demat — 5-Level L2 FULL Mode) ---
# Either provide ANGELONE_JWT_TOKEN directly, OR provide Client Code + PIN + TOTP Secret
# for automatic daily login at 09:14 IST:
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PIN=
ANGELONE_TOTP_SECRET=
ANGELONE_JWT_TOKEN=
